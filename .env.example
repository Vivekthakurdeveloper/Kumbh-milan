# Copy to .env and replace every placeholder. Never commit .env.

# --- Application ---
APP_ENV=local
DOCS_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL (docker compose) ---
POSTGRES_OWNER_USER=kumbh_owner
POSTGRES_OWNER_PASSWORD=change-me-owner-password
KUMBH_APP_DB_USER=kumbh_app
KUMBH_APP_DB_PASSWORD=change-me-app-password

# Used when running the API or Alembic outside docker compose.
DATABASE_URL=postgresql+psycopg://kumbh_owner:change-me-owner-password@localhost:5432/kumbh_setu
# Role that receives least-privilege grants during `alembic upgrade head` (optional outside compose).
KUMBH_APP_DB_ROLE=kumbh_app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000

# Dedicated test database. Tests TRUNCATE every table: never point this at a real database.
TEST_DATABASE_URL=postgresql+psycopg://kumbh_owner:change-me-owner-password@localhost:5432/kumbh_setu_test

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-48-byte-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Fernet key for owner/family contact details.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- Object storage (SeaweedFS locally, any S3-compatible private bucket in production) ---
# Locally these credentials also configure the SeaweedFS identity in docker compose.
S3_ENDPOINT_URL=http://localhost:8333
# Public host of the object store, only when browsers can reach it (CDN or public S3 hostname).
# Leave empty to have the API serve photos itself (/api/v1/media/...), which works wherever the console reaches the API.
S3_PUBLIC_ENDPOINT_URL=
# auto (default): presigned links when S3_PUBLIC_ENDPOINT_URL is set or storage is AWS S3, otherwise API-served links.
MEDIA_DELIVERY=auto
# Public origin of this API, used to build API-served media links (required in staging and production when they are used).
# Leave empty locally: the origin of the incoming request is used.
API_PUBLIC_BASE_URL=
S3_REGION=ap-south-1
S3_BUCKET=kumbh-setu-media
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key
# AES256 or aws:kms on AWS S3. Leave empty locally: SeaweedFS encrypts volume data itself.
S3_SERVER_SIDE_ENCRYPTION=
S3_PRESIGN_TTL_SECONDS=300

# --- Uploads ---
MAX_PHOTO_BYTES=10485760
MAX_AUDIO_BYTES=26214400
MAX_REQUEST_BYTES=31457280
# clamav outside local/test. disabled marks new uploads SKIPPED_DEV and must not be used in production.
SCAN_MODE=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_SECONDS=3
CLAMAV_TIMEOUT_SECONDS=60
SCAN_MAX_ATTEMPTS=6
SCAN_RETRY_BASE_SECONDS=30
SCAN_STALE_AFTER_SECONDS=300

# --- Abuse protection ---
# memory is per process. staging and production require redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_REFRESH_PER_MINUTE=60
RATE_LIMIT_PASSWORD_PER_HOUR=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=10
RATE_LIMIT_RESET_PASSWORD_PER_HOUR=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_CASE_CREATE_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=180

# --- Mobile offline sync ---
SYNC_MAX_BATCH=50
# Pull withholds writes newer than this many seconds so late-committing transactions are never skipped.
SYNC_PULL_LAG_SECONDS=5

# Required by docker compose even when the API rate limiter stays in memory.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@localhost:6380/0
REDIS_TIMEOUT_MS=250

# --- Workers and readiness ---
# true makes /ready fail until scan, notifications, cleanup, and retention heartbeats are fresh.
WORKERS_REQUIRED=false
WORKER_HEARTBEAT_MAX_AGE_SECONDS=180

# --- Notifications ---
# disabled, console, mock (local/test), or msg91 (requires auth key + DLT template ids).
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_STALE_AFTER_SECONDS=300
NOTIFICATION_DEFAULT_COUNTRY_CODE=+91
# MSG91: set NOTIFICATION_PROVIDER=msg91 only after DLT-approved template IDs exist.
# MSG91_TEMPLATE_IDS is JSON, e.g. {"OTP_CODE":"…","CASE_SUBMITTED":"…","CASE_APPROVED":"…"}
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5
MSG91_TEMPLATE_IDS={}
MSG91_TIMEOUT_SECONDS=10
# SMTP: enable only with approved credentials. Live delivery not verified in automated tests.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Kumbh Setu
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# FCM: requires pip install '.[push]' and Firebase service-account JSON; iOS needs APNs in Firebase.
FCM_ENABLED=false
FCM_CREDENTIALS_JSON=
FCM_CREDENTIALS_FILE=

# --- Public citizen portal ---
# Required outside local/test. Intake user must be an active HELP_DESK_OPERATOR at the intake station.
PUBLIC_SECURITY_SECRET=
PUBLIC_INTAKE_USER_ID=
PUBLIC_INTAKE_STATION_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
PUBLIC_STATUS_TOKEN_TTL_MINUTES=15
PUBLIC_VERIFIED_MOBILE_TOKEN_TTL_MINUTES=30
RATE_LIMIT_PUBLIC_OTP_PER_MINUTE=10
RATE_LIMIT_PUBLIC_SUBMIT_PER_MINUTE=20
RATE_LIMIT_PUBLIC_STATUS_PER_MINUTE=30

# --- Forgot password (email or SMS one-time codes) ---
# disabled, console, mock, or smtp. console logs the code (local only); staging and production need smtp or disabled.
EMAIL_PROVIDER=disabled
EMAIL_FROM=Kumbh Setu <no-reply@localhost>
# starttls, ssl, or none (none only for a local relay such as MailHog)
PASSWORD_RESET_CODE_LENGTH=8
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3

# --- Retention (operational defaults, not legally approved periods) ---
RETENTION_ARCHIVE_AFTER_DAYS=90
RETENTION_ANONYMIZE_AFTER_DAYS=365
RETENTION_ATTACHMENT_PURGE_AFTER_DAYS=30
RETENTION_MAX_ITEMS_PER_RUN=5000
# Owner URL used only by `python -m app.cli retention-execute`. Leave empty for local API execution.
RETENTION_DATABASE_URL=

# --- Geo ---
GEO_OPERATING_AREA=[29.70,77.90,30.25,78.45]
GEO_MAX_RADIUS_M=10000
GEO_MAX_BBOX_DEGREES=0.5
GEO_MAP_LIMIT=500
MATCHING_AUTO_ENABLED=true

# --- Face matching (Phase 2) ---
FACE_MATCHING_ENABLED=true
FACE_ENGINE=opencv_sface
FACE_MODEL_DIR=models/faces
FACE_SIMILARITY_THRESHOLD=0.363
FACE_MAX_CANDIDATES=5
FACE_CANDIDATE_WINDOW_DAYS=14
FACE_DETECTION_MIN_SCORE=0.9
FACE_MIN_SIZE_PX=40
# Separate Fernet key for facial embeddings. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_EMBEDDING_ENCRYPTION_KEY=
FACE_EMBEDDING_RETENTION_DAYS=30

# --- HTTP and observability ---
# Empty list: ignore X-Forwarded-For and use the socket peer. Uvicorn runs with --no-proxy-headers.
TRUSTED_PROXIES=[]
LOG_FORMAT=json
# Required in staging and production. Leave empty locally.
METRICS_TOKEN=
# disabled or totp. totp is optional step-up and is not phishing-resistant.
MFA_MODE=disabled
